{
  "name": "twitch-donations-tombola",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Real-time Twitch charity raffle and tombola platform with Streamlabs webhooks, OBS overlay and admin control",
  "license": "MIT",
  "author": "Romain Cheiko",
  "repository": {
    "type": "git",
    "url": "https://github.com/rcheiko/twitch-donations-tombola.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@tombola/web...",
    "build:api": "turbo run build --filter=@tombola/api...",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "turbo": "^2.5.4"
  }
}
