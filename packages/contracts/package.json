{
  "name": "@tombola/contracts",
  "version": "0.1.0",
  "description": "Shared Zod schemas, TypeScript types, and WebSocket contracts for tombola",
  "license": "MIT",
  "author": "Romain Cheiko",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tombola/config": "*",
    "typescript": "^5.8.2"
  }
}
