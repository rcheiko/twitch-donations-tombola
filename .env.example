# ==============================================================================
# TWITCH & STREAMLABS TOMBOLA — ENVIRONMENT VARIABLES
# Copy this file to '.env' for local development.
# ==============================================================================

# Environment (development | production | test)
# 'test' is the ONLY switch enabling test mode (it skips the production secret checks).
NODE_ENV=production

# Server listening port (API + WebSockets + Static Frontend)
PORT=3000
HOST=0.0.0.0

# Persistence directory for 'backup.json' and the 'archive/' sub-directory
# In production on CapRover, mount a Persistent Directory on '/app/data'
# A relative value (default: ./data) is resolved against the directory of this .env file.
DATA_DIR=/app/data

# ------------------------------------------------------------------------------
# 1. STREAMLABS CHARITY REAL-TIME DONATIONS (SOCKET API TOKEN)
# Streamlabs Charity donations travel on the SAME Streamlabs Socket API and the SAME
# token as classic tips — only the event type differs (`streamlabscharitydonation`).
# There is no separate Charity token and no extra variable to set.
#
# How to get it: In Streamlabs Dashboard (streamlabs.com/dashboard), click your profile (top-right) ->
# Account Settings -> API Settings -> API Tokens tab -> "Your Socket API Token".
# Copy the token and paste it here.
#
# Prerequisite: the Streamlabs account owning this token must be linked to the
# Streamlabs Charity campaign, otherwise no charity event is ever delivered.
# Classic Streamlabs tips are deliberately IGNORED: only Streamlabs Charity donations
# credit tickets. This is the ONLY donation channel (no HTTP webhook). Required in production.
# ------------------------------------------------------------------------------
STREAMLABS_SOCKET_TOKEN=

# ------------------------------------------------------------------------------
# 2. ADMIN DASHBOARD SECURITY
# Secret key required to log in and control the raffle from /admin
# In production, use at least 16 random characters (e.g. openssl rand -hex 24)
# ------------------------------------------------------------------------------
ADMIN_SECRET_KEY=generate_a_very_long_and_secure_random_string_here

# NOTE: Raffle configuration (prize title, ticket price, subtitles, timer duration)
# is configured directly from the live Admin UI (/admin) and automatically persisted
# to backup.json.
